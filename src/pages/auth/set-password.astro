---
import Layout from "@/layouts/Layout.astro";
import { parseSetPasswordLink } from "@/lib/services/invitation";

// The token is in the address, so no cache may keep this page and no Referer may carry the address to another site.
// Opening the page spends nothing: mail scanners open links, so the token is spent only by POST /api/auth/set-password,
// after it has checked the password.
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const link = parseSetPasswordLink(Astro.url.searchParams.get("token_hash"), Astro.url.searchParams.get("type"));
if (link === null) {
  Astro.response.status = 400;
}

const inputClass =
  "w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/40 transition-colors focus:ring-2 focus:ring-purple-400 focus:outline-none [color-scheme:dark]";
---

<Layout title={link ? "Ustaw hasło" : "Link jest nieprawidłowy"}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      {link ? (
        <>
          <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
            Ustaw hasło
          </h1>
          {/* A plain form without script: the SetPasswordForm island (live rule check, JSON POST) replaces it. */}
          <form method="post" data-set-password-form class="space-y-4">
            <input type="hidden" name="tokenHash" value={link.tokenHash} />
            <input type="hidden" name="type" value={link.type} />
            <label for="password" class="block text-sm text-blue-100/80">
              <span class="mb-1 block">Hasło</span>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                required
                class:list={inputClass}
              />
            </label>
            <label for="passwordRepeat" class="block text-sm text-blue-100/80">
              <span class="mb-1 block">Powtórz hasło</span>
              <input
                id="passwordRepeat"
                name="passwordRepeat"
                type="password"
                autocomplete="new-password"
                required
                class:list={inputClass}
              />
            </label>
            <button
              type="submit"
              class="w-full rounded-lg bg-purple-600 px-4 py-2 font-medium text-white transition-colors hover:bg-purple-500"
            >
              Ustaw hasło
            </button>
          </form>
        </>
      ) : (
        <div class="text-center">
          <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
            Link jest nieprawidłowy
          </h1>
          <p class="text-blue-100/80">Poproś planistę o nowe zaproszenie.</p>
        </div>
      )}
    </div>
  </div>
</Layout>
