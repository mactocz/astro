---
import PlannerLayout from "@/layouts/PlannerLayout.astro";
import { listEmployees } from "@/lib/employees";
import { formatFteLabel } from "@/lib/services/employee";

const { supabase } = Astro.locals;
if (!supabase) {
  // The access gate lets nobody through without a configured client, so this is a misconfiguration.
  throw new Error("The Supabase client is missing; check SUPABASE_URL and SUPABASE_KEY.");
}

const employees = await listEmployees(supabase);

// Names and e-mail addresses are personal data: no cache may keep this page.
Astro.response.headers.set("Cache-Control", "no-store");
---

<PlannerLayout title="Pracownicy">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
      Pracownicy ({employees.length})
    </h1>
    <a
      href="/employees/new"
      class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
    >
      Dodaj pracownika
    </a>
  </div>

  {employees.length === 0 ? (
    <p class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-blue-100/80 backdrop-blur-xl">
      Nie dodano jeszcze żadnego pracownika.
    </p>
  ) : (
    <>
      <div class="hidden overflow-hidden rounded-2xl border border-white/10 bg-white/10 backdrop-blur-xl md:block">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-white/10 text-blue-100/60">
            <tr>
              <th scope="col" class="px-4 py-3 font-medium">
                Nazwisko i imię
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                E-mail
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Etat
              </th>
              <th scope="col" class="px-4 py-3">
                <span class="sr-only">Akcje</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            {employees.map((employee) => (
              <tr>
                <td class="px-4 py-3 font-semibold text-white">
                  {employee.lastName} {employee.firstName}
                </td>
                <td class="px-4 py-3 break-all text-blue-100/80">{employee.email ?? "—"}</td>
                <td class="px-4 py-3 whitespace-nowrap text-blue-100/80">{formatFteLabel(employee.fte)}</td>
                <td class="px-4 py-3 text-right">
                  <a
                    href={`/employees/${employee.id}`}
                    aria-label={`Edytuj: ${employee.lastName} ${employee.firstName}`}
                    class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                  >
                    Edytuj
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ul class="space-y-3 md:hidden">
        {employees.map((employee) => (
          <li class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
            <p class="font-semibold text-white">
              {employee.lastName} {employee.firstName}
            </p>
            <p class="mt-1 text-sm break-all text-blue-100/80">{employee.email ?? "—"}</p>
            <p class="mt-1 text-sm text-blue-100/80">{formatFteLabel(employee.fte)}</p>
            <a
              href={`/employees/${employee.id}`}
              aria-label={`Edytuj: ${employee.lastName} ${employee.firstName}`}
              class="mt-3 inline-block py-1 text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
            >
              Edytuj
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
</PlannerLayout>
