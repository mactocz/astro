---
import PlannerLayout from "@/layouts/PlannerLayout.astro";
import EmployeeForm from "@/components/employees/EmployeeForm";
import { getEmployee } from "@/lib/employees";

const { supabase } = Astro.locals;
if (!supabase) {
  // The access gate lets nobody through without a configured client, so this is a misconfiguration.
  throw new Error("The Supabase client is missing; check SUPABASE_URL and SUPABASE_KEY.");
}

// getEmployee answers null for an id that is not a UUID, without querying the database.
const { id } = Astro.params;
const employee = id === undefined ? null : await getEmployee(supabase, id);

// The project has no 404 page, so a missing employee gets its own message with this status.
if (!employee) {
  Astro.response.status = 404;
}
// The form carries the employee's name and e-mail address: no cache may keep this page.
Astro.response.headers.set("Cache-Control", "no-store");
---

<PlannerLayout title={employee ? "Edytuj pracownika" : "Nie znaleziono pracownika"}>
  {employee ? (
    <div class="mx-auto w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl sm:p-8">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Edytuj pracownika
      </h1>
      <EmployeeForm employee={employee} client:load />
    </div>
  ) : (
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Nie znaleziono pracownika
      </h1>
      <a href="/employees" class="text-purple-300 hover:underline">
        Wróć do listy pracowników
      </a>
    </div>
  )}
</PlannerLayout>
