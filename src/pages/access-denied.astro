---
import Layout from "@/layouts/Layout.astro";
import type { Role } from "@/types";

const { user, role } = Astro.locals;

// The middleware rewrites here without setting a status, and the page is also open directly, so derive it from the user.
Astro.response.status = user ? 403 : 401;
Astro.response.headers.set("Cache-Control", "no-store");

const ROLE_LABELS: Record<Role, string> = { planner: "planista", employee: "pracownik" };
const roleLabel = role ? ROLE_LABELS[role] : "brak roli";
---

<Layout title="Brak dostępu">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Brak dostępu
      </h1>
      {user ? (
        <>
          <p class="text-blue-100/80">
            Zalogowano jako <span class="font-semibold text-white">{user.email}</span>
          </p>
          <p class="mt-2 text-sm text-blue-100/50">Rola: {roleLabel}. Ta strona nie jest dostępna dla Twojej roli.</p>
          <form method="POST" action="/api/auth/signout" class="mt-6">
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
            >
              Wyloguj się
            </button>
          </form>
        </>
      ) : (
        <>
          <p class="text-blue-100/80">Zaloguj się, aby uzyskać dostęp do tej strony.</p>
          <a
            href="/auth/signin"
            class="mt-6 inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Zaloguj się
          </a>
        </>
      )}
    </div>
  </div>
</Layout>
