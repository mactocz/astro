---
import PlannerLayout from "@/layouts/PlannerLayout.astro";
import ScheduleNotice from "@/components/schedules/ScheduleNotice.astro";
import { listSchedules } from "@/lib/schedules";
import { formatPeriod } from "@/lib/services/schedule";

const { supabase } = Astro.locals;
if (!supabase) {
  // The access gate lets nobody through without a configured client, so this is a misconfiguration.
  throw new Error("The Supabase client is missing; check SUPABASE_URL and SUPABASE_KEY.");
}

const schedules = await listSchedules(supabase);

// The day a schedule was created, as the planner's calendar shows it (Polish time), not the UTC day of the timestamp.
const createdFormat = new Intl.DateTimeFormat("pl-PL", {
  timeZone: "Europe/Warsaw",
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});
const rows = schedules.map((schedule) => {
  const period = formatPeriod(schedule.startDate);
  return {
    id: schedule.id,
    period,
    label: schedule.label,
    employeeCount: schedule.employeeCount,
    totalRequired: schedule.totalRequired,
    created: createdFormat.format(new Date(schedule.createdAt)),
    // Every row says "Edytuj" and "Obsadź", so each link is named by the period and by the label that tells drafts of one
    // period apart.
    editLabel: schedule.label ? `Edytuj: ${period}, ${schedule.label}` : `Edytuj: ${period}`,
    assignLabel: schedule.label ? `Obsadź: ${period}, ${schedule.label}` : `Obsadź: ${period}`,
  };
});

// The pages of the schedules show names of people (the form), so none of them is cached; the list follows the same rule.
Astro.response.headers.set("Cache-Control", "no-store");
---

<PlannerLayout title="Grafiki">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
      Grafiki ({rows.length})
    </h1>
    <a
      href="/schedules/new"
      class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
    >
      Nowy grafik
    </a>
  </div>

  <ScheduleNotice />

  {rows.length === 0 ? (
    <p class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-blue-100/80 backdrop-blur-xl">
      Nie utworzono jeszcze żadnego grafiku.
    </p>
  ) : (
    <>
      <div class="hidden overflow-hidden rounded-2xl border border-white/10 bg-white/10 backdrop-blur-xl md:block">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-white/10 text-blue-100/60">
            <tr>
              <th scope="col" class="px-4 py-3 font-medium">
                Okres
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Etykieta
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Pracownicy
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Suma obsady
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Utworzono
              </th>
              <th scope="col" class="px-4 py-3">
                <span class="sr-only">Akcje</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            {rows.map((row) => (
              <tr>
                <td class="px-4 py-3 font-semibold whitespace-nowrap text-white">{row.period}</td>
                <td class="px-4 py-3 break-words text-blue-100/80">{row.label ?? "—"}</td>
                <td class="px-4 py-3 whitespace-nowrap text-blue-100/80">{row.employeeCount}</td>
                <td class="px-4 py-3 whitespace-nowrap text-blue-100/80">{row.totalRequired}</td>
                <td class="px-4 py-3 whitespace-nowrap text-blue-100/80">{row.created}</td>
                <td class="px-4 py-3 text-right">
                  <a
                    href={`/schedules/${row.id}`}
                    aria-label={row.editLabel}
                    class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                  >
                    Edytuj
                  </a>
                  <a
                    href={`/schedules/${row.id}/assign`}
                    aria-label={row.assignLabel}
                    class="ml-4 text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                  >
                    Obsadź
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ul class="space-y-3 md:hidden">
        {rows.map((row) => (
          <li class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
            <p class="font-semibold text-white">{row.period}</p>
            {row.label && <p class="mt-1 text-sm break-words text-blue-100/80">{row.label}</p>}
            <p class="mt-1 text-sm text-blue-100/80">Pracownicy: {row.employeeCount}</p>
            <p class="mt-1 text-sm text-blue-100/80">Suma obsady: {row.totalRequired}</p>
            <p class="mt-1 text-sm text-blue-100/80">Utworzono: {row.created}</p>
            <a
              href={`/schedules/${row.id}`}
              aria-label={row.editLabel}
              class="mt-3 inline-block py-1 text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
            >
              Edytuj
            </a>
            <a
              href={`/schedules/${row.id}/assign`}
              aria-label={row.assignLabel}
              class="mt-3 ml-4 inline-block py-1 text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
            >
              Obsadź
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
</PlannerLayout>
