---
import PlannerLayout from "@/layouts/PlannerLayout.astro";
import { ABSENCE_LIST_LIMIT, listAbsencesPage } from "@/lib/absences";
import { listEmployees } from "@/lib/employees";
import { toEmployeeOptions } from "@/lib/schedule-options";
import {
  absenceDayCount,
  absenceStatusLabel,
  absenceTypeLabel,
  formatAbsenceDays,
  formatAbsenceRange,
} from "@/lib/services/absence";
import { addDays } from "@/lib/services/schedule";

const { supabase } = Astro.locals;
if (!supabase) {
  // The access gate lets nobody through without a configured client, so this is a misconfiguration.
  throw new Error("The Supabase client is missing; check SUPABASE_URL and SUPABASE_KEY.");
}

// Two views of the list. The default one shows the absences that ended in the last twelve months or are still going on (the
// day today is read in UTC, as every date of the rules is); "?all=1" shows every absence, and any other value of the
// parameter is the default view. Both are read from the database newest first and cut at ABSENCE_LIST_LIMIT rows.
const showAll = Astro.url.searchParams.get("all") === "1";
const today = new Date().toISOString().slice(0, 10);
const endingFrom = showAll ? undefined : addDays(today, -365);
const [{ absences, truncated }, employees] = await Promise.all([
  listAbsencesPage(supabase, { endingFrom }),
  listEmployees(supabase),
]);

// The people by name only ("Last name First name"): the list never shows an e-mail address. An absence always has its person
// in the roster (the foreign key), so the placeholder is for a row that this session cannot match to one.
const UNKNOWN_PERSON = "Nieznany pracownik";
const names = new Map(toEmployeeOptions(employees).map(({ id, name }) => [id, name]));

// What each row says, worked out once: the type and the status as words (never a colour alone), the days with their number
// ("24.11–26.11.2026 (3 dni)"), and the range alone for the label of the edit link, which names the absence and not its length.
const rows = absences.map((absence) => {
  const person = names.get(absence.employeeId) ?? UNKNOWN_PERSON;
  const type = absenceTypeLabel(absence.type);
  const range = formatAbsenceRange(absence);
  return {
    id: absence.id,
    person,
    type,
    days: `${range} (${formatAbsenceDays(absenceDayCount(absence))})`,
    status: absenceStatusLabel(absence.status),
    editLabel: `Edytuj: ${person}, ${type}, ${range}`,
  };
});

// The page says which view is on and links to the other one. An empty default view cannot tell an empty table from one whose
// absences are all older, so it says only what it shows.
const viewNote = showAll
  ? "Pokazano wszystkie nieobecności."
  : "Pokazano nieobecności zakończone w ostatnich 12 miesiącach lub trwające.";
const viewLink = showAll
  ? { href: "/absences", text: "Pokaż tylko ostatnie 12 miesięcy" }
  : { href: "/absences?all=1", text: "Pokaż starsze" };
const emptyText = showAll ? "Nie wpisano jeszcze żadnej nieobecności." : "Brak nieobecności z ostatnich 12 miesięcy.";
const truncatedNote = truncated ? `Lista jest obcięta do najnowszych ${ABSENCE_LIST_LIMIT} nieobecności.` : null;

// The names of employees and the kinds of their absences (an L4 is health data): no cache may keep this page.
Astro.response.headers.set("Cache-Control", "no-store");
---

<PlannerLayout title="Nieobecności">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
    <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
      Nieobecności ({rows.length})
    </h1>
    <a
      href="/absences/new"
      class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
    >
      Dodaj nieobecność
    </a>
  </div>

  <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
    <p data-absence-view-note class="text-blue-100/60">
      {viewNote}
    </p>
    <a
      href={viewLink.href}
      data-absence-view-link
      class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
    >
      {viewLink.text}
    </a>
  </div>

  {rows.length === 0 ? (
    <p class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-blue-100/80 backdrop-blur-xl">
      {emptyText}
    </p>
  ) : (
    <>
      <div class="hidden overflow-hidden rounded-2xl border border-white/10 bg-white/10 backdrop-blur-xl md:block">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-white/10 text-blue-100/60">
            <tr>
              <th scope="col" class="px-4 py-3 font-medium">
                Pracownik
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Rodzaj
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Dni
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Status
              </th>
              <th scope="col" class="px-4 py-3">
                <span class="sr-only">Akcje</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            {rows.map((row) => (
              <tr data-absence-id={row.id}>
                <td class="px-4 py-3 font-semibold break-words text-white">{row.person}</td>
                <td class="px-4 py-3 text-blue-100/80">{row.type}</td>
                <td class="px-4 py-3 whitespace-nowrap text-blue-100/80">{row.days}</td>
                <td class="px-4 py-3 whitespace-nowrap text-blue-100/80">{row.status}</td>
                <td class="px-4 py-3 text-right">
                  <a
                    href={`/absences/${row.id}`}
                    aria-label={row.editLabel}
                    class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                  >
                    Edytuj
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ul class="space-y-3 md:hidden">
        {rows.map((row) => (
          <li data-absence-id={row.id} class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
            <p class="font-semibold break-words text-white">{row.person}</p>
            <p class="mt-1 text-sm text-blue-100/80">{row.type}</p>
            <p class="mt-1 text-sm text-blue-100/80">{row.days}</p>
            <p class="mt-1 text-sm text-blue-100/80">Status: {row.status}</p>
            <a
              href={`/absences/${row.id}`}
              aria-label={row.editLabel}
              class="mt-3 inline-block py-1 text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
            >
              Edytuj
            </a>
          </li>
        ))}
      </ul>

      {truncatedNote && (
        <p data-absence-truncated-note class="mt-4 text-sm text-blue-100/60">
          {truncatedNote}
        </p>
      )}
    </>
  )}
</PlannerLayout>
