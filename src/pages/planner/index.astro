---
import PlannerLayout from "@/layouts/PlannerLayout.astro";
---

<PlannerLayout title="Panel planisty" showBackLink={false}>
  <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
    Panel planisty
  </h1>
  <div class="grid gap-4 sm:grid-cols-2">
    <a
      href="/employees"
      class="block rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl transition-colors hover:bg-white/15"
    >
      <h2 class="text-lg font-semibold text-white">Pracownicy</h2>
      <p class="mt-1 text-sm text-blue-100/80">Lista zespołu z etatami. Dodawaj pracowników i zmieniaj ich dane.</p>
    </a>
  </div>
</PlannerLayout>
