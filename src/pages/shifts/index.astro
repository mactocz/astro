---
import PlannerLayout from "@/layouts/PlannerLayout.astro";
import { listShifts } from "@/lib/shifts";
import { endsNextDay, formatDuration, formatShiftTimes, shiftDurationMinutes } from "@/lib/services/shift";

const { supabase } = Astro.locals;
if (!supabase) {
  // The access gate lets nobody through without a configured client, so this is a misconfiguration.
  throw new Error("The Supabase client is missing; check SUPABASE_URL and SUPABASE_KEY.");
}

const shifts = await listShifts(supabase);
---

<PlannerLayout title="Zmiany">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
      Zmiany ({shifts.length})
    </h1>
    <a
      href="/shifts/new"
      class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
    >
      Dodaj zmianę
    </a>
  </div>

  {shifts.length === 0 ? (
    <p class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-blue-100/80 backdrop-blur-xl">
      Nie zdefiniowano jeszcze żadnej zmiany.
    </p>
  ) : (
    <>
      <div class="hidden overflow-hidden rounded-2xl border border-white/10 bg-white/10 backdrop-blur-xl md:block">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-white/10 text-blue-100/60">
            <tr>
              <th scope="col" class="px-4 py-3 font-medium">
                Nazwa
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Godziny
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Czas trwania
              </th>
              <th scope="col" class="px-4 py-3">
                <span class="sr-only">Akcje</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            {shifts.map((shift) => (
              <tr>
                <td class="px-4 py-3 font-semibold break-words text-white">{shift.name}</td>
                <td class="px-4 py-3 whitespace-nowrap text-blue-100/80">
                  {formatShiftTimes(shift)}
                  {endsNextDay(shift) && <span class="ml-1 text-xs text-purple-300">następnego dnia</span>}
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-blue-100/80">
                  {formatDuration(shiftDurationMinutes(shift))}
                </td>
                <td class="px-4 py-3 text-right">
                  <a
                    href={`/shifts/${shift.id}`}
                    aria-label={`Edytuj: ${shift.name}`}
                    class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                  >
                    Edytuj
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ul class="space-y-3 md:hidden">
        {shifts.map((shift) => (
          <li class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
            <p class="font-semibold break-words text-white">{shift.name}</p>
            <p class="mt-1 text-sm text-blue-100/80">
              {formatShiftTimes(shift)}
              {endsNextDay(shift) && <span class="ml-1 text-xs text-purple-300">następnego dnia</span>}
            </p>
            <p class="mt-1 text-sm text-blue-100/80">Czas trwania: {formatDuration(shiftDurationMinutes(shift))}</p>
            <a
              href={`/shifts/${shift.id}`}
              aria-label={`Edytuj: ${shift.name}`}
              class="mt-3 inline-block py-1 text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
            >
              Edytuj
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
</PlannerLayout>
