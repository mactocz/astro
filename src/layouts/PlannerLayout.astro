---
import Layout from "@/layouts/Layout.astro";

interface Props {
  title: string;
  showBackLink?: boolean;
}

const { title, showBackLink = true } = Astro.props;
const { user } = Astro.locals;
---

<Layout title={title}>
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto w-full max-w-4xl">
      <header class="mb-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm">
        {showBackLink && (
          <a href="/planner" class="py-1 text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            ← Panel planisty
          </a>
        )}
        <div class="ml-auto flex min-w-0 items-center gap-3">
          <span class="truncate text-blue-100/70">{user?.email}</span>
          <form method="POST" action="/api/auth/signout" class="shrink-0">
            <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Wyloguj się
            </button>
          </form>
        </div>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </div>
</Layout>
